layout {
    gaps 12

    border {
        off
    }

	always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667 
    }

    default-column-width { proportion 0.5; }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        draw-behind-window true
        color "#0007"
    }

    struts {}
}
